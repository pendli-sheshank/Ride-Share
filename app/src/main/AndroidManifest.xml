<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      The app has had haptic feedback helpers since the start and never declared this, so every
      vibrate() call threw a SecurityException straight into the `catch (e: Exception) {}` that
      wraps it: the feature has silently never worked. A normal permission, so no runtime prompt.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      Runtime permission on API 33+. Without it the system drops every notification silently — the
      same failure mode as the undeclared VIBRATE permission, which made every haptic call throw
      into a bare catch and meant the feature had never once worked.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Address suggestions are ranked by how far each result is from the user. Coarse is all the
      ranking needs, so the app requests coarse only — asking for ACCESS_FINE_LOCATION would be an
      over-request of a more sensitive permission the code never uses. The app asks the first time an
      address field is focused, never at launch.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name="com.splitcruiser.app.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Receives pushes and token rotations. Not exported: only the system delivers to it, and an
          exported messaging service would let any app on the device spoof a notification.
        -->
        <service
            android:name="com.splitcruiser.app.push.SplitCruiserMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          The channel FCM falls back to when a notification arrives with no channel of its own.
          It must exist before any notification is posted or API 26+ drops it silently, so
          `SplitCruiserNotifications.ensureChannel` creates it at startup as well.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/push_channel_id" />

        <!--
          AdMob's application id. **Required, not optional.** With play-services-ads on the
          classpath and this meta-data absent, the SDK throws at initialisation and the app dies
          on launch. The value is a manifest placeholder filled from ADMOB_APP_ID, defaulting to
          Google's public sample id so a build with no secrets still starts — see
          app/build.gradle.kts.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!--
          Defers ads-SDK initialisation to our own call in `SplitCruiserAds`, which runs the UMP
          consent flow first. Left at the default, the SDK initialises itself from a
          ContentProvider at process start — before any consent decision exists, which is the
          policy violation this whole ordering exists to avoid.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" />
    </application>

</manifest>
