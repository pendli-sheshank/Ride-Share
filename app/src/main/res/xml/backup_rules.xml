<?xml version="1.0" encoding="utf-8"?>
<!--
  Controls Auto Backup on Android 11 and below (API <= 30).

  Excludes the session SharedPreferences files, which hold the Firebase refresh token — a long-lived
  credential that must not be copied off-device by Auto Backup or `adb backup`. Both the current
  Keystore-backed file and any leftover legacy plaintext file are excluded. Everything else is still
  backed up.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="split_cruiser_secure_session.xml"/>
    <exclude domain="sharedpref" path="split_cruiser_session.xml"/>
</full-backup-content>
