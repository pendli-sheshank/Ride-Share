<?xml version="1.0" encoding="utf-8"?>
<!--
  The badge sits in the adaptive icon's 72dp safe zone over its own navy, rather than filling the
  108dp canvas: the outer third can be cropped by the launcher's mask, and this artwork is a
  self-contained badge with a glowing border that would be sliced off. Generated by
  scripts/generate-app-icon.py.

  No <monochrome> layer. Themed icons need a single-colour silhouette, and neither the artwork nor
  the old placeholder vector is one — shipping a wrong monochrome is worse than shipping none,
  which simply falls back to the full-colour icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_navy" />
    <foreground android:drawable="@drawable/ic_launcher_fg" />
</adaptive-icon>
