rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================
    // PROFILE PICTURES
    // ============================================

    match /profile_pictures/{userId}.jpg {
      // Public, so the feed can render an avatar without a signed URL.
      allow read: if true;

      // Two fixes over the previous version:
      //
      // 1. On a delete, `request.resource` is null, so `request.resource.size` failed to evaluate
      //    and the rule denied. Deleting a profile picture could never have worked.
      // 2. `request.auth.uid` on an unauthenticated request evaluates null.uid, which errors rather
      //    than denying cleanly.
      //
      // The client must send a bare `image/jpeg` content type — appending a charset breaks the
      // equality check below.
      allow write: if request.auth != null && request.auth.uid == userId && (
        request.resource == null || (
          request.resource.size <= 5 * 1024 * 1024 && // Max 5MB
          request.resource.contentType == 'image/jpeg'
        )
      );
    }

    // ============================================
    // TRIP DOCUMENTS (Future — currently disabled)
    // ============================================

    // No client in this repo reads or writes this path yet. Left open, `if request.auth != null`
    // was a live bucket: any signed-in user could upload unlimited files of any size and type under
    // any tripId and read anyone else's — arbitrary file hosting on a firebasestorage.googleapis.com
    // URL and unbounded egress billing. Denied until a real feature turns it on with per-participant
    // authorization plus size and content-type caps (mirror the profile_pictures rule).
    match /trip_documents/{tripId}/{document=**} {
      allow read, write: if false;
    }

    // ============================================
    // DENY ALL OTHER UPLOADS
    // ============================================

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
