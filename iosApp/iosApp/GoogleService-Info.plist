<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PLACEHOLDER. Not the real Firebase configuration, and not a secret.

  The real file comes from the GOOGLE_SERVICE_INFO_PLIST secret and is written over this one by
  .github/workflows/ios-release.yml. A placeholder has to be committed because the app target's
  Resources build phase references this path, and the PR simulator build runs with no secrets —
  without a file here that build fails on a missing resource.

  API_KEY is the sentinel SplitCruiserPush.isConfigured checks. While it reads
  PLACEHOLDER_NOT_CONFIGURED the app does not call FirebaseApp.configure() at all, so push is
  off and visibly off. That matters: Firebase validates nothing at configure time, so given fake
  values it would hand out a token-shaped failure indistinguishable from a working registration.
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>PLACEHOLDER_NOT_CONFIGURED</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.splitcruiser.app</string>
	<key>PROJECT_ID</key>
	<string>placeholder-not-configured</string>
	<key>STORAGE_BUCKET</key>
	<string>placeholder-not-configured.appspot.com</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<false/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
</dict>
</plist>
