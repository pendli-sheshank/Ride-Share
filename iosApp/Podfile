platform :ios, '14.0'

# No pods are declared. Shared.xcframework is produced by Gradle
# (./gradlew :shared:assembleSharedReleaseXCFramework) and linked by the Xcode project
# directly via FRAMEWORK_SEARCH_PATHS, not through CocoaPods.
#
# This file is kept only so that adding a dependency later does not require rediscovering
# the platform/target setup. Nothing in CI runs `pod install`: with no pods to install it
# would only force every build to use a .xcworkspace instead of the .xcodeproj.
#
# NOTE: do not add a nested `target 'iosAppTests'` block until that target actually exists
# in iosApp.xcodeproj. It did before, and `pod install` aborted every run with
# "Unable to find a target named `iosAppTests`".

target 'iosApp' do
  use_frameworks!
  use_modular_headers!
end
