# FIREBASE CONFIGURATION (Optional - or place google-services.json in /app)
FIREBASE_API_KEY="FIREBASE_API_KEY_PLACEHOLDER"
FIREBASE_APP_ID="FIREBASE_APP_ID_PLACEHOLDER"
FIREBASE_PROJECT_ID="FIREBASE_PROJECT_ID_PLACEHOLDER"
FIREBASE_STORAGE_BUCKET="FIREBASE_STORAGE_BUCKET_PLACEHOLDER"
# OAuth 2.0 *Web* client ID, created when the Google sign-in provider is enabled. Optional:
# leave it unset and the app offers email/password only.
GOOGLE_WEB_CLIENT_ID="GOOGLE_WEB_CLIENT_ID_PLACEHOLDER"
# This project's Firestore database id is "splitcruiser", not the "(default)" every project gets
# automatically, and that is the built-in default here too. Only set this if your own copy of the
# project used a different Database ID — check Firestore Database -> the id next to the database
# name in the console.
# FIRESTORE_DATABASE_ID="splitcruiser"
