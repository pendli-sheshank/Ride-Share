rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Which fields a write actually changes. The clients send a narrow updateMask precisely so
    // these checks can stay tight.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Whether the caller may take a seat on, or accept, a ride marked women-only.
    //
    // Gender lives on the caller's *private* profile document, not on users/{uid}, because that one
    // is readable by every signed-in user. Rules run server-side and can read it regardless, which
    // is what lets this be enforced without publishing anything.
    //
    // "Women only" was previously gated solely on `isWomenOnlyFilterEnabled` — a self-service
    // boolean any account could flip — with no gender recorded anywhere and no rule behind it. It
    // was a display filter presented as a safety control.
    //
    // Deliberately used ONLY on write rules. A read/list rule that calls get() breaks list queries
    // outright, which this repo has already been bitten by once (see the skill's known-issues log).
    // Feed visibility is filtered client-side in FeedProjector; this is the half that has teeth.
    function isWomenOnlyEligible() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/private/profile) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/private/profile)
          .data.get('gender', 'unspecified') == 'woman';
    }

    // ============================================
    // COLLECTION: users
    // ============================================

    match /users/{userId} {
      // Readable to any signed-in user so feeds can show a host's name and rating. NOT public:
      // `allow read: if true` let anyone holding the (shippable) API key bulk-read every user's
      // name, email, phone number and FCM token with a plain REST call. `isAuth()` closes the
      // anonymous path. The phone number still reaches every *signed-in* user; moving contact
      // fields off this document entirely is a tracked follow-up (needs both-platform UI changes).
      allow read: if isAuth();

      allow create: if isOwner(userId);

      // Reputation aggregates and the trust tier are written *about* a user, derived from the
      // ratings and no-show reports, and must be computed server-side. The Admin SDK in
      // functions/ (aggregateRating, aggregateNoShow) bypasses these rules and is the only writer
      // of ratingAvg/ratingCount/noShowCount/verifiedTier. A client — even the owner — may update
      // any other field but must leave these four alone, which stops both cross-user tampering and
      // owner self-inflation (a user setting their own ratingAvg to 5.0).
      allow update: if isOwner(userId) &&
        !changed().hasAny(['ratingAvg', 'ratingCount', 'noShowCount', 'verifiedTier']);

      allow delete: if isOwner(userId);

      // Private block list. The client writes here rather than to a top-level `blocks` collection,
      // which was never declared in these rules and so could only ever have been denied.
      match /blockedUsers/{blockedId} {
        allow read, write: if isOwner(userId);
      }

      // Onboarding's contact details — the home address a ride request prefills from. The user
      // document itself is world-readable so feeds can show a host's name and rating, which is
      // exactly why a home address does not belong on it.
      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ============================================
    // COLLECTION: trip_offers
    // ============================================

    match /trip_offers/{offerId} {
      allow read: if isAuth();

      allow create: if isAuth() && request.resource.data.hostId == request.auth.uid;

      // Joining a ride, accepting a match and declining one all change someone else's offer, so the
      // host is not the only allowed writer. But the previous rule let *any* authenticated user set
      // seatsLeft/status/passengers to anything — zero out every ride, cancel other people's trips,
      // or delete riders from the manifest. A non-host is confined to moving *themselves* in or out
      // of the passenger list, with seatsLeft kept in range and status limited to the two the
      // seat-booking flow legitimately sets.
      //
      // Three further constraints make the seat count an invariant the *server* enforces rather
      // than one the client is trusted to maintain:
      //
      //   1. The manifest changes by exactly one entry. `hasAll` alone let a joiner add themselves
      //      *and* any number of ids that were never on the ride.
      //   2. seatsLeft must move in the right direction — strictly down to join, strictly up to
      //      leave. Without this a rider could add themselves while leaving seatsLeft untouched, so
      //      a full ride never reads as full, or "free up" seats on someone else's ride at will.
      //   3. passengers and passengerNames stay the same length. The client keeps two parallel
      //      arrays and the UI zips them, so a length mismatch silently pairs a name with the wrong
      //      rider — worth refusing at the door.
      //
      // Exact seat *arithmetic* still cannot live here, because one passenger entry may consume
      // several seats (RideRequest.seatsNeeded), which this document does not record. The client
      // does that arithmetic under a currentDocument.updateTime precondition (see claimSeat), so a
      // concurrent join is rejected and retried rather than silently overbooking.
      allow update: if isAuth() && (
        resource.data.hostId == request.auth.uid ||
        (
          changed().hasOnly(['passengers', 'passengerNames', 'seatsLeft', 'status']) &&
          request.resource.data.seatsLeft is int &&
          request.resource.data.seatsLeft >= 0 &&
          request.resource.data.seatsLeft <= resource.data.totalSeats &&
          request.resource.data.status in ['active', 'full'] &&
          request.resource.data.passengerNames.size() == request.resource.data.passengers.size() &&
          (
            // Joining: adds only the caller, keeps every existing passenger, and costs a seat.
            // A women-only ride admits only eligible riders — this is the enforcement point that
            // turns the flag from a display filter into a restriction.
            (
              (resource.data.get('womenOnly', false) == false || isWomenOnlyEligible()) &&
              !(request.auth.uid in resource.data.passengers) &&
              request.auth.uid in request.resource.data.passengers &&
              request.resource.data.passengers.hasAll(resource.data.passengers) &&
              request.resource.data.passengers.size() == resource.data.passengers.size() + 1 &&
              request.resource.data.seatsLeft < resource.data.seatsLeft
            ) ||
            // Leaving: removes only the caller, keeps every other passenger, and returns a seat.
            (
              request.auth.uid in resource.data.passengers &&
              !(request.auth.uid in request.resource.data.passengers) &&
              resource.data.passengers.hasAll(request.resource.data.passengers) &&
              request.resource.data.passengers.size() == resource.data.passengers.size() - 1 &&
              request.resource.data.seatsLeft > resource.data.seatsLeft
            )
          )
        )
      );

      allow delete: if isAuth() && resource.data.hostId == request.auth.uid;
    }

    // ============================================
    // COLLECTION: ride_requests
    // ============================================

    match /ride_requests/{requestId} {
      allow read: if isAuth();

      allow create: if isAuth() && request.resource.data.riderId == request.auth.uid;

      // A host flips the rider's request to "matched" when accepting, so this cannot be rider-only.
      // A non-rider may only change `status`, and only to one of the known values — not rewrite the
      // route, rider identity or departure time on someone else's request.
      allow update: if isAuth() && (
        resource.data.riderId == request.auth.uid ||
        (
          changed().hasOnly(['status']) &&
          request.resource.data.status in ['active', 'pending', 'matched', 'closed', 'cancelled']
        )
      );

      allow delete: if isAuth() && resource.data.riderId == request.auth.uid;
    }

    // ============================================
    // COLLECTION: trip_matches
    // ============================================

    match /trip_matches/{matchId} {
      // Self-contained on purpose. The previous rule called get() on the very document being read,
      // and Firestore caps get()/exists() at ten per query across the whole result set — so any
      // query returning more than a handful of matches failed with a PERMISSION_DENIED that said
      // nothing about the limit.
      allow read: if isAuth() && (
        resource.data.hostId == request.auth.uid ||
        resource.data.riderId == request.auth.uid
      );

      // Both sides of a women-only ride must be eligible: a rider joining a women-only offer, and
      // a host accepting a women-only request. Checked here as well as on the seat write, because
      // offerSeatForRequest and acceptRideRequestDirect reach the manifest from the other
      // direction — via a backing offer the host owns, where the host branch above applies.
      allow create: if isAuth() &&
        (
          request.resource.data.hostId == request.auth.uid ||
          request.resource.data.riderId == request.auth.uid
        ) &&
        (
          !exists(/databases/$(database)/documents/ride_requests/$(request.resource.data.requestId)) ||
          get(/databases/$(database)/documents/ride_requests/$(request.resource.data.requestId))
            .data.get('womenOnly', false) == false ||
          isWomenOnlyEligible()
        );

      allow update, delete: if isAuth() && (
        resource.data.hostId == request.auth.uid ||
        resource.data.riderId == request.auth.uid
      );
    }

    // ============================================
    // COLLECTION: messages
    // ============================================

    match /messages/{messageId} {
      // Reads the denormalised participants array rather than following matchId, for the same
      // get()-budget reason as trip_matches.
      allow read: if isAuth() && request.auth.uid in resource.data.participants;

      allow create: if isAuth() &&
        request.resource.data.senderId == request.auth.uid &&
        request.auth.uid in request.resource.data.participants;

      // A sender may correct or delete their own message, but not rewrite its identity, thread,
      // audience, timestamp or the agreed contribution after the fact — that would let a party
      // repudiate a price both sides had seen. Delete is unconstrained (removing a message you sent
      // has no such state to forge).
      allow update: if isOwner(resource.data.senderId) &&
        !changed().hasAny(['matchId', 'senderId', 'timestamp', 'participants', 'contribution']);
      allow delete: if isOwner(resource.data.senderId);
    }

    // ============================================
    // COLLECTION: notifications
    // ============================================

    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);

      // These are written *for* another user — the host is told a rider joined, the rider is told
      // they were accepted. `if false` assumed a backend that does not exist in this repo, so every
      // notification the app has ever tried to send would have been denied. Bound the shape instead.
      allow create: if isAuth() &&
        request.resource.data.keys().hasOnly(
          ['id', 'userId', 'title', 'message', 'type', 'timestamp', 'isRead']
        ) &&
        request.resource.data.isRead == false &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 1000 &&
        // Bind the timestamp to server time (client clocks are attacker-controlled). Without this a
        // notification could be dated far in the future to pin itself to the top of the recipient's
        // list — which orders by timestamp DESC. Allow a little skew each way.
        request.resource.data.timestamp is int &&
        request.resource.data.timestamp <= request.time.toMillis() + 60000 &&
        request.resource.data.timestamp >= request.time.toMillis() - 300000;

      // The recipient may only mark it read.
      allow update: if isOwner(resource.data.userId) && changed().hasOnly(['isRead']);

      allow delete: if isOwner(resource.data.userId);
    }

    // ============================================
    // COLLECTION: ratings
    // ============================================

    match /ratings/{ratingId} {
      allow read: if isAuth();

      // The field is fromUserId. These rules checked `raterId`, which the Rating model has never
      // had, so every rating write would have been denied.
      //
      // Validation: a rater cannot rate themselves, the score must be a number in 1..5 (the old
      // rules let `submitRating(victim, 1e9f, "")` through, which then poisoned the aggregate), and
      // the free-text comment is length-capped. A Cloud Function (aggregateRating) recomputes the
      // target's ratingAvg/ratingCount from these documents, so the score here has to be sane.
      allow create: if isAuth() &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.fromUserId != request.resource.data.toUserId &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() <= 500;
      allow update: if isAuth() &&
        resource.data.fromUserId == request.auth.uid &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.comment.size() <= 500;
      allow delete: if isAuth() && resource.data.fromUserId == request.auth.uid;
    }

    // ============================================
    // COLLECTION: no_show_reports
    // ============================================

    // A rider or host reports that the other party did not turn up. One document per
    // (reporter, target) pair, immutable once written; the aggregateNoShow Cloud Function counts
    // them with the Admin SDK and writes the target's noShowCount. Clients can no longer touch that
    // counter directly (see the users rule), which is what made it forgeable before.
    match /no_show_reports/{reportId} {
      allow read: if isAuth() && resource.data.reporterId == request.auth.uid;

      allow create: if isAuth() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.reporterId != request.resource.data.targetId &&
        request.resource.data.keys().hasOnly(['id', 'reporterId', 'targetId', 'timestamp']);

      // Immutable. Only the Admin SDK aggregates them.
      allow update, delete: if false;
    }

    // ============================================
    // COLLECTION: vehicles
    // ============================================

    match /vehicles/{userId} {
      // Riders need to see the car they are getting into — but a licence plate is not something to
      // publish to the anonymous internet, so this is signed-in-only rather than fully public.
      allow read: if isAuth();
      allow write: if isOwner(userId);
    }

    // `communities` is deliberately absent: onboarding no longer collects a community, so nothing
    // reads or writes that collection any more. Any documents left over in a live project from
    // before this change are orphaned but harmless.

    // `invites` is deliberately absent: signup is no longer gated on a code, so the collection has
    // no client that reads or writes it and the catch-all below denies it.

    // ============================================
    // DENY ALL OTHER COLLECTIONS
    // ============================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
