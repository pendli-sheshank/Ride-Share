rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Which fields a write actually changes. The clients send a narrow updateMask precisely so
    // these checks can stay tight.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ============================================
    // COLLECTION: users
    // ============================================

    match /users/{userId} {
      // Public, so feeds can show a host's name and rating.
      allow read: if true;

      allow create: if isOwner(userId);

      // Ratings and no-show counts are aggregates written *about* a user by someone else, so the
      // owner-only rule that used to guard the whole document made submitRating and recordNoShow
      // impossible. This is deliberately narrow but still spoofable — anyone can inflate anyone's
      // rating. The real fix is a Cloud Function holding the Admin SDK; until then this at least
      // bounds the damage to three numeric fields.
      allow update: if isOwner(userId) ||
        (isAuth() && changed().hasOnly(['ratingAvg', 'ratingCount', 'noShowCount']));

      allow delete: if isOwner(userId);

      // Private block list. The client writes here rather than to a top-level `blocks` collection,
      // which was never declared in these rules and so could only ever have been denied.
      match /blockedUsers/{blockedId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ============================================
    // COLLECTION: trip_offers
    // ============================================

    match /trip_offers/{offerId} {
      allow read: if true;

      allow create: if isAuth() && request.resource.data.hostId == request.auth.uid;

      // Joining a ride, accepting a match and declining one all change someone else's offer. The
      // previous host-only rule denied every one of them. A non-host may touch only the seat and
      // passenger bookkeeping.
      allow update: if isAuth() && (
        resource.data.hostId == request.auth.uid ||
        changed().hasOnly(['passengers', 'passengerNames', 'seatsLeft', 'status'])
      );

      allow delete: if isAuth() && resource.data.hostId == request.auth.uid;
    }

    // ============================================
    // COLLECTION: ride_requests
    // ============================================

    match /ride_requests/{requestId} {
      allow read: if true;

      allow create: if isAuth() && request.resource.data.riderId == request.auth.uid;

      // A host flips the rider's request to "matched" when accepting, so this cannot be rider-only.
      allow update: if isAuth() && (
        resource.data.riderId == request.auth.uid ||
        changed().hasOnly(['status'])
      );

      allow delete: if isAuth() && resource.data.riderId == request.auth.uid;
    }

    // ============================================
    // COLLECTION: trip_matches
    // ============================================

    match /trip_matches/{matchId} {
      // Self-contained on purpose. The previous rule called get() on the very document being read,
      // and Firestore caps get()/exists() at ten per query across the whole result set — so any
      // query returning more than a handful of matches failed with a PERMISSION_DENIED that said
      // nothing about the limit.
      allow read: if isAuth() && (
        resource.data.hostId == request.auth.uid ||
        resource.data.riderId == request.auth.uid
      );

      allow create: if isAuth() && (
        request.resource.data.hostId == request.auth.uid ||
        request.resource.data.riderId == request.auth.uid
      );

      allow update, delete: if isAuth() && (
        resource.data.hostId == request.auth.uid ||
        resource.data.riderId == request.auth.uid
      );
    }

    // ============================================
    // COLLECTION: messages
    // ============================================

    match /messages/{messageId} {
      // Reads the denormalised participants array rather than following matchId, for the same
      // get()-budget reason as trip_matches.
      allow read: if isAuth() && request.auth.uid in resource.data.participants;

      allow create: if isAuth() &&
        request.resource.data.senderId == request.auth.uid &&
        request.auth.uid in request.resource.data.participants;

      allow update, delete: if isOwner(resource.data.senderId);
    }

    // ============================================
    // COLLECTION: notifications
    // ============================================

    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);

      // These are written *for* another user — the host is told a rider joined, the rider is told
      // they were accepted. `if false` assumed a backend that does not exist in this repo, so every
      // notification the app has ever tried to send would have been denied. Bound the shape instead.
      allow create: if isAuth() &&
        request.resource.data.keys().hasOnly(
          ['id', 'userId', 'title', 'message', 'type', 'timestamp', 'isRead']
        ) &&
        request.resource.data.isRead == false &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 1000;

      // The recipient may only mark it read.
      allow update: if isOwner(resource.data.userId) && changed().hasOnly(['isRead']);

      allow delete: if isOwner(resource.data.userId);
    }

    // ============================================
    // COLLECTION: ratings
    // ============================================

    match /ratings/{ratingId} {
      allow read: if true;

      // The field is fromUserId. These rules checked `raterId`, which the Rating model has never
      // had, so every rating write would have been denied.
      allow create: if isAuth() && request.resource.data.fromUserId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.fromUserId == request.auth.uid;
    }

    // ============================================
    // COLLECTION: vehicles
    // ============================================

    match /vehicles/{userId} {
      // Riders need to see the car they are getting into.
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // ============================================
    // COLLECTION: communities
    // ============================================

    match /communities/{communityId} {
      allow read: if true;
      // Still client-read-only. The app ships DEFAULT_COMMUNITIES so the picker is populated even
      // when this collection is empty.
      allow write: if false;
    }

    // ============================================
    // COLLECTION: invites
    // ============================================

    match /invites/{inviteId} {
      allow read: if isAuth();

      // Invites must be seeded out of band — see the release runbook. But redeeming one is a client
      // action, and `write: if false` denied it, so the invite flow could never have completed.
      // Permit exactly the redemption transition and nothing else.
      allow create: if false;
      allow update: if isAuth() &&
        resource.data.used == false &&
        request.resource.data.used == true &&
        request.resource.data.usedBy == request.auth.uid &&
        changed().hasOnly(['used', 'usedBy']);
      allow delete: if false;
    }

    // ============================================
    // DENY ALL OTHER COLLECTIONS
    // ============================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
